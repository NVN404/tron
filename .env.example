# PostgreSQL Connection Strings
SOURCE_DATABASE_URL=postgres://postgres:postgres@localhost:5433/source_db_1
SOURCE_PG_1_DATABASE_URL=postgres://postgres:postgres@localhost:5433/source_db_1
SOURCE_PG_2_DATABASE_URL=postgres://postgres:postgres@localhost:5435/source_db_2
SOURCE_MYSQL_DATABASE_URL=mysql://root:root@localhost:3306/source_db
SOURCE_MONGO_DATABASE_URL=mongodb://localhost:27017/source_db?replicaSet=rs0&directConnection=true
ANALYTICS_DATABASE_URL=postgres://postgres:postgres@localhost:5434/analytics_db
ANALYTICS_RO_DATABASE_URL=postgres://api_ro:api_ro_secret@localhost:5434/analytics_db

# REST API Configuration
API_HOST=0.0.0.0
API_PORT=8080

# Logging & Telemetry
RUST_LOG=info,worker=debug,api=debug,capture=debug

# Aggregation Worker Configuration
WORKER_BATCH_SIZE=1000
WORKER_LEASE_SECONDS=30
WORKER_POLL_INTERVAL_MS=500

# Timezone Configuration
TIMEZONE=Asia/Kolkata
